HUGGINGFACEHUB_ACCESS_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =========================================================================
# Azure OpenAI — Chat
# =========================================================================
AZURE_OPENAI_ENDPOINT="https://<your-chat-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5

# =========================================================================
# Azure OpenAI — Embedding  [DEPRECATED — replaced by Voyage voyage-context-3]
# Kept commented for reference/rollback. Chat still uses Azure OpenAI above.
# =========================================================================
# AZURE_OPENAI_EMBEDDING_ENDPOINT="https://<your-embedding-resource>.openai.azure.com/"
# AZURE_OPENAI_EMBEDDING_API_KEY=""
# AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# =========================================================================
# Voyage AI — embeddings (voyage-context-3, contextualized chunk embeddings)
# =========================================================================
VOYAGE_API_KEY="pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VOYAGE_EMBEDDING_MODEL=voyage-context-3
VOYAGE_RERANK_MODEL=rerank-2.5

# Hybrid retrieval (BM25 + vector) + reranking
FULLTEXT_INDEX_NAME=text_search_index
RETRIEVE_K=20        # candidates from hybrid search before reranking
RERANK_TOP_N=6       # docs kept after Voyage rerank, passed to the LLM

# =========================================================================
# Vector store config
# voyage-context-3 output dimensions: 1024 (default), or 256 / 512 / 2048.
# =========================================================================
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_NAME=embedding_vector_index

# =========================================================================
# MongoDB Atlas
# =========================================================================
MONGODB_ATLAS_CLUSTER_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
MONGODB_DB_NAME=trip
CHAT_HISTORY_COLLECTION=chat_history

# =========================================================================
# Redis — semantic cache (needs the Search/vector module, e.g. Redis Cloud free tier)
# Leave REDIS_URI unset/blank to DISABLE the cache (every query hits the LLM).
# Use rediss:// for TLS (Redis Cloud).
# =========================================================================
REDIS_URI="rediss://default:<password>@<host>.redns.redis-cloud.com:<port>"
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=3600


# =========================================================================
# LangSmith tracing (observability) — set LANGSMITH_TRACING=true to enable.
# LangChain auto-traces every chain run when these are present; no code change.
# =========================================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY="lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LANGSMITH_PROJECT=chat-with-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
